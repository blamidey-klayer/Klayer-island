    "Choose the tools you use. Klayer Island only shows what you declare here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الأدوات التي تستخدمها. يعرض Klayer Island فقط ما تُعلنه هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যে টুলগুলো ব্যবহার করেন তা বেছে নিন। Klayer Island শুধুমাত্র আপনার ঘোষণা করা জিনিস দেখায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the tools you use. Klayer Island only shows what you declare here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las herramientas que usas. Klayer Island solo muestra lo que declares aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les outils que tu utilises. Klayer Island n'affiche que ce que tu déclares ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे टूल चुनें जो आप उपयोग करते हैं। Klayer Island केवल वही दिखाता है जो आप यहाँ घोषित करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
