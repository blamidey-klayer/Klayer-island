# Maintainer: FabioLukas123
# Klayer Island for Arch Linux — built from the Tauri app in windows/, which runs on
# Windows and Linux alike.

pkgname=klayer-git
_pkgname=klayer
pkgver=0.2.0
pkgrel=1
pkgdesc="Klay lives at the top of your screen and keeps an eye on your Claude Code sessions"
arch=('x86_64' 'aarch64')
url="https://github.com/blamidey-klayer/Klayer-notif"
license=("MIT" "LicenseRef-klayer-assets")
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'gtk-layer-shell'
  'libayatana-appindicator'
  'gst-plugins-base'
  'gst-plugins-good'
  'dbus'
  'xdg-utils'
  'hicolor-icon-theme'
)
optdepends=(
  'gnome-keyring: store API keys (or any other Secret Service provider)'
  'kwallet: store API keys (or any other Secret Service provider)'
)
makedepends=('git' 'cargo' 'nodejs' 'npm')
provides=("$_pkgname")
conflicts=("$_pkgname")
# makepkg's default LTO and debug flags make the Rust build very slow.
options=('!lto' '!debug')
source=("$_pkgname::git+https://github.com/blamidey-klayer/Klayer-notif.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local v
  v=$(sed -n 's/^version = "\(.*\)"/\1/p' windows/Cargo.toml | head -1)
  printf "%s.r%s.%s" "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname/windows"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  npm ci
}

build() {
  cd "$_pkgname/windows"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$PWD/target"
  # beforeBuildCommand builds the front end and the klayer-hook relay.
  npx tauri build --no-bundle
}

package() {
  cd "$_pkgname"
  install -Dm755 windows/target/release/klayer "$pkgdir/usr/bin/klayer"
  # Found next to the app, then copied into ~/.local/share/klayer/bin at launch.
  install -Dm755 windows/target/release/klayer-hook "$pkgdir/usr/bin/klayer-hook"
  install -Dm644 linux/arch/klayer.desktop "$pkgdir/usr/share/applications/klayer.desktop"
  install -Dm644 windows/src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/klayer.png"
  install -Dm644 windows/src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/klayer.png"
  install -Dm644 windows/src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/klayer.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-ASSETS.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ASSETS.md"
}
